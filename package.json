{
  "name": "opsfactor-community-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:edition-boundaries && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "verify:edition-boundaries": "node ./scripts/verify-edition-boundaries.mjs",
    "test:contracts": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e:community-public": "playwright test tests/e2e/community-public-smoke.spec.ts",
    "test:e2e:enterprise-appearance": "playwright test --config playwright.enterprise.config.ts"
  },
  "dependencies": {
    "@opsfactor/front-core": "file:./packages/front-core",
    "@opsfactor/front-plan-history": "file:./packages/front-plan-history",
    "@opsfactor/front-planning-book": "file:./packages/front-planning-book",
    "@opsfactor/front-processes": "file:./packages/front-processes",
    "@opsfactor/front-perspective": "file:./packages/front-perspective",
    "@opsfactor/front-shell": "file:./packages/front-shell",
    "@perspective-dev/client": "4.3.0",
    "@perspective-dev/viewer": "4.3.0",
    "@perspective-dev/viewer-datagrid": "4.3.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "ag-grid-community": "35.1.0",
    "ag-grid-vue3": "35.1.0",
    "echarts": "6.0.0",
    "elkjs": "0.11.1",
    "filepond": "4.32.12",
    "filepond-plugin-file-validate-type": "1.2.9",
    "leaflet": "1.9.4",
    "pinia": "^3.0.1",
    "primevue": "4.5.4",
    "vue": "3.5.30",
    "vue-echarts": "8.0.1",
    "vue-filepond": "7.0.4",
    "vue-router": "^4.5.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.12"
  }
}
