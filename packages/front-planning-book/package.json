{
  "name": "@opsfactor/front-planning-book",
  "version": "0.1.0",
  "description": "Edition-neutral structural Planning Book grid foundation for OpsFactor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && vite build && vue-tsc --project tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json",
    "test:contracts": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@opsfactor/front-shell": "^0.1.0",
    "ag-grid-community": "^35.1.0",
    "ag-grid-vue3": "^35.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.12"
  }
}
